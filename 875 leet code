class Solution:
    def minEatingSpeed(self, piles: list[int], h: int) -> int:
        low, high = 1, max(piles)
        while low < high:
            mid = (low + high) // 2
            hours_needed = sum(math.ceil(pile / mid) for pile in piles)
            if hours_needed <= h:
                high = mid
            else:
                low = mid + 1
        return low
