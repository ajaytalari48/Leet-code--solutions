from collections import Counter


class Solution:
    def smallestUniqueSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        b1, m1 = 100003, 1_000_000_007
        b2, m2 = 100019, 1_000_000_009

        p1 = [1] * (n + 1)
        p2 = [1] * (n + 1)
        for i in range(1, n + 1):
            p1[i] = (p1[i - 1] * b1) % m1
            p2[i] = (p2[i - 1] * b2) % m2

        def has_unique_of_len(length: int) -> bool:
            h1 = h2 = 0
            for i in range(length):
                h1 = (h1 * b1 + nums[i]) % m1
                h2 = (h2 * b2 + nums[i]) % m2

            counts = Counter([(h1, h2)])
            pow1 = p1[length - 1]
            pow2 = p2[length - 1]

            for i in range(length, n):
                out_val = nums[i - length]
                in_val = nums[i]

                h1 = (h1 - out_val * pow1) % m1
                h1 = (h1 * b1 + in_val) % m1

                h2 = (h2 - out_val * pow2) % m2
                h2 = (h2 * b2 + in_val) % m2

                counts[(h1, h2)] += 1

            return any(freq == 1 for freq in counts.values())

        low, high = 1, n
        ans = n
        while low <= high:
            mid = (low + high) // 2
            if has_unique_of_len(mid):
                ans = mid
                high = mid - 1
            else:
                low = mid + 1

        return ans
