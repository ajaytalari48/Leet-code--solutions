import math


class Solution:
    def maxLength(self, nums: list[int]) -> int:
        n = len(nums)
        best = 0
        for i in range(n):
            prod = 1
            g = 0
            l = 1
            for j in range(i, n):
                x = nums[j]
                prod *= x
                g = x if j == i else math.gcd(g, x)
                l = math.lcm(l, x)
                if prod == l * g and (j - i + 1) > best:
                    best = j - i + 1
                if prod > 2520 * g * l:
                    break
        return best
