class Solution:
    def kInversePairs(self, n: int, k: int) -> int:
        MOD = 10**9 + 7
        
        # dp[j] will represent the number of ways to get j inverse pairs
        dp = [0] * (k + 1)
        dp[0] = 1  # Base case: 1 way to have 0 inverse pairs with 0 elements

        for i in range(1, n + 1):
            next_dp = [0] * (k + 1)
            next_dp[0] = 1
            
            for j in range(1, k + 1):
                # Add current dp value
                val = (next_dp[j - 1] + dp[j]) % MOD
                # Subtract element that falls out of window [j - (i - 1), j]
                if j >= i:
                    val = (val - dp[j - i] + MOD) % MOD
                next_dp[j] = val
                
            dp = next_dp

        return dp[k]
